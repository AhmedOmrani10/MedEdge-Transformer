\@writefile{toc}{\contentsline {section}{\numberline {1.5}Limitations and Clinical Drawbacks}{10}{section.1.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Illustrative pain score trajectories over one year. In naive users with fresh lancets, NRS pain score declines from $\sim $5.0 to 2.6 as fingertip skin keratinises~\cite  {laser2022}. In patients who reuse lancets (the majority, per Peled et al.~\cite  {peled2012}), pain does not decline and may increase as needle blunting requires greater penetration force.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:fingerstick_pain}{{1.3}{10}{Illustrative pain score trajectories over one year. In naive users with fresh lancets, NRS pain score declines from $\sim $5.0 to 2.6 as fingertip skin keratinises~\cite {laser2022}. In patients who reuse lancets (the majority, per Peled et al.~\cite {peled2012}), pain does not decline and may increase as needle blunting requires greater penetration force}{figure.caption.13}{}}
\citation{dcct1993}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces Four SMBG snapshots per day (red circles) miss the postprandial peaks at hours 8--9 (245~mg/dL) and hours 13--14 (225~mg/dL), and miss any nocturnal hypoglycaemia occurring between measurements. This discontinuity is structural limitation of episodic monitoring that cannot be resolved by improving strip chemistry.}}{11}{figure.caption.15}\protected@file@percent }
\newlabel{fig:fingerstick_timeseries}{{1.4}{11}{Four SMBG snapshots per day (red circles) miss the postprandial peaks at hours 8--9 (245~mg/dL) and hours 13--14 (225~mg/dL), and miss any nocturnal hypoglycaemia occurring between measurements. This discontinuity is structural limitation of episodic monitoring that cannot be resolved by improving strip chemistry}{figure.caption.15}{}}
