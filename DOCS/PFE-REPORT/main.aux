\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces Cumulative cost of fingerstick SMBG over 12 months at \$0.98/strip and \$0.10/lancet, consistent with Yeaw et al.~\cite  {yeaw2012}. Type~1 patients testing 5 times daily accumulate $\approx $\$1,944 per year in consumables alone, before adding meter costs, batteries, and any CGM backup testing.}}{13}{figure.caption.19}\protected@file@percent }
\newlabel{fig:fingerstick_cost}{{1.5}{13}{Cumulative cost of fingerstick SMBG over 12 months at \$0.98/strip and \$0.10/lancet, consistent with Yeaw et al.~\cite {yeaw2012}. Type~1 patients testing 5 times daily accumulate $\approx $\$1,944 per year in consumables alone, before adding meter costs, batteries, and any CGM backup testing}{figure.caption.19}{}}
